---
interface Props {
  province?: 'cordoba' | 'mendoza';
}

const { province } = Astro.props;

const commonBadges = [
  { text: 'AFIP', style: 'italic' },
  { text: 'Ley 27.349 (Capital Emprendedor)', style: 'span' },
  { text: 'Firma Digital Certificada', style: 'span' },
];

const regionalBadges = {
  cordoba: [
    { text: 'IPJ Córdoba', style: 'italic' },
    { text: 'CiDi Nivel 2', style: 'span' },
    { text: 'Bancor', style: 'italic' },
  ],
  mendoza: [
    { text: 'DPJ Mendoza', style: 'italic' },
    { text: 'Mendoza por Mí (MxM)', style: 'span' },
    { text: 'Ventanilla Única E-SAS', style: 'italic' },
  ],
  default: [
    { text: 'Inspección de Personas Jurídicas', style: 'italic' },
    { text: 'Registro Público', style: 'span' },
    { text: 'Mendoza por Mí', style: 'span' },
    { text: 'CiDi Nivel 2', style: 'span' },
  ]
};

const displayBadges = [...commonBadges, ...(province ? regionalBadges[province] : regionalBadges.default)];
---
<section class="trust-badges-section">
  <div class="container">
    <p class="section-label font-sans reveal">Procesos estandarizados bajo normativas de:</p>
    <div class="marquee-wrapper reveal delay-200">
      <div class="marquee">
        <!-- Bloque duplicado para el scroll infinito -->
        <div class="marquee-content">
          {displayBadges.map((badge) => (
            <div class="badge-item">
              {badge.style === 'italic' ? <i>{badge.text}</i> : <span>{badge.text}</span>}
            </div>
          ))}
        </div>
        <div class="marquee-content" aria-hidden="true">
          {displayBadges.map((badge) => (
            <div class="badge-item">
              {badge.style === 'italic' ? <i>{badge.text}</i> : <span>{badge.text}</span>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-badges-section {
    padding: 2rem 0 4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background: linear-gradient(180deg, rgba(10,10,12,0) 0%, rgba(18,18,21,0.5) 100%);
    position: relative;
    z-index: 5;
  }
  
  .section-label {
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 2rem;
  }

  .marquee-wrapper {
    overflow: hidden;
    position: relative;
    width: 100%;
    /* Efecto de fade en los bordes */
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  .marquee {
    display: flex;
    width: fit-content;
  }

  .marquee-content {
    display: flex;
    align-items: center;
    gap: 4rem;
    padding-right: 4rem;
    animation: scroll 30s linear infinite;
  }

  .badge-item {
    color: rgba(255, 255, 255, 0.4);
    font-size: 1.1rem;
    white-space: nowrap;
    transition: color var(--transition-smooth);
    display: flex;
    align-items: center;
  }

  .badge-item i {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 1.1rem;
  }
  
  .badge-item span {
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-item:hover {
    color: var(--text-primary);
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  @media (max-width: 768px) {
    .trust-badges-section {
      padding: 1rem 0 3rem;
    }
    .marquee-content {
      gap: 2.5rem;
      padding-right: 2.5rem;
    }
    .badge-item {
      font-size: 0.95rem;
    }
    .badge-item i {
      font-size: 1.1rem;
    }
  }
</style>
