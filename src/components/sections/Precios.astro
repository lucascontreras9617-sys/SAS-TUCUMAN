---
---
<section class="pricing-section" id="honorarios">
  <div class="container">
    <div class="section-header reveal">
      <h2>Inversión <span class="text-gold">Transparente</span></h2>
      <p>Paquetes de constitución de SAS diseñados para cada necesidad, con honorarios claros desde el primer momento.</p>
    </div>

    <div class="pricing-grid">
      <!-- Plan Básico -->
      <div class="pricing-card glass-panel reveal delay-100">
        <div class="card-header">
          <h3>SAS <br/>Estándar</h3>
          <div class="price">Consultar</div>
          <p class="subtitle">Ideal para emprendedores individuales o socios únicos.</p>
        </div>
        <ul class="features">
          <li>
            <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Estatuto Modelo IGJ/Registro
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Inscripción en Registro Público
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Obtención de CUIT
          </li>
        </ul>
        <div class="card-footer">
          <a href="#contacto" class="btn-secondary">Solicitar Presupuesto</a>
        </div>
      </div>

      <!-- Plan Premium -->
      <div class="pricing-card featured glass-panel reveal delay-200">
        <div class="badge-popular">El más elegido</div>
        <div class="card-header">
          <h3>SAS <br/><span class="text-gold">Premium</span></h3>
          <div class="price">Consultar</div>
          <p class="subtitle">Constitución integral societaria y fiscal para PyMEs.</p>
        </div>
        <ul class="features">
          <li>
            <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Estatuto Personalizado Revisor
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Inscripción CUIT e Impuestos
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Libros Digitales Iniciales
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Asesoría Contable Regalo (Mes 1)
          </li>
        </ul>
        <div class="card-footer">
          <a href="#contacto" class="btn-primary">Contactar Ahora</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    padding: 100px 0;
    position: relative;
    background: radial-gradient(ellipse at bottom, rgba(212, 175, 55, 0.05) 0%, transparent 60%);
  }
  
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .section-header h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  
  .section-header p {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .pricing-grid {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .pricing-card {
    flex: 1;
    min-width: 320px;
    max-width: 400px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  
  .pricing-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }
  
  .pricing-card.featured {
    border-color: rgba(212, 175, 55, 0.3);
    background: linear-gradient(180deg, rgba(212, 175, 55, 0.05) 0%, var(--glass-bg) 100%);
  }

  .badge-popular {
    position: absolute;
    top: 24px;
    right: 24px;
    background: var(--accent-gold);
    color: #000;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
    z-index: 10;
  }

  .card-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--glass-border);
    padding-bottom: 2rem;
  }
  
  .card-header h3 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  
  .price {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .features {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin-bottom: 2.5rem;
  }
  
  .features li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--text-primary);
    font-size: 0.95rem;
  }
  
  .check-icon {
    width: 20px;
    height: 20px;
    color: var(--accent-gold);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .card-footer {
    display: flex;
    justify-content: stretch;
  }
  
  .card-footer a {
    width: 100%;
  }

  @media (max-width: 768px) {
    .pricing-grid {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
