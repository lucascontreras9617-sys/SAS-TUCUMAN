---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Constituí tu Sociedad por Acciones Simplificada (SAS) de forma rápida, 100% digital y con respaldo legal de primer nivel en Argentina.", 
  image = "/og-image.jpg" 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://sasargentina.com.ar');

const schemaData = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "name": "SAS Argentina - Legal-Tech",
  "image": "https://sasargentina.com.ar/logo.jpg",
  "description": description,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Córdoba / Mendoza",
    "addressRegion": "Argentina",
    "addressCountry": "AR"
  },
  "url": typeof Astro.site === 'string' ? Astro.site : 'https://sasargentina.com.ar',
  "telephone": "+5493816447082",
  "priceRange": "$$"
};
---
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={`${title} | Quiet Luxury Legal`} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, canonicalURL)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={`${title} | Quiet Luxury Legal`} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, canonicalURL)} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
