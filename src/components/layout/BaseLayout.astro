---
import '../../styles/global.css';
import Navigation from './Navigation.astro';
import CustomCursor from '../ui/CustomCursor.astro';
import SEO from './SEO.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}{title.includes('|') ? '' : ' | Estudio SAS'}</title>
    
    <SEO title={title} />
    <ViewTransitions />

    <!-- Theme init: runs before first paint and is re-applied on every ViewTransition -->
    <script is:inline>
      // Apply theme from localStorage (or system preference) immediately
      (function() {
        var saved = typeof localStorage !== 'undefined' && localStorage.getItem('theme');
        var theme = saved
          ? saved
          : window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();

      // Before ViewTransition swaps the DOM, copy the current theme to the new document
      document.addEventListener('astro:before-swap', function(e) {
        var current = document.documentElement.getAttribute('data-theme')
          || localStorage.getItem('theme')
          || 'dark';
        e.newDocument.documentElement.setAttribute('data-theme', current);
      });

      // After swap, re-apply from localStorage as safety net
      document.addEventListener('astro:after-swap', function() {
        var saved = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', saved);
      });
    </script>
  </head>
  <body>
    <div class="ambient-orb"></div>
    <div class="ambient-orb"></div>
    <div class="scroll-progress-container">
      <div class="scroll-progress-line" id="progress-line"></div>
    </div>
    <CustomCursor />
    
    <Navigation />
    <main>
      <slot />
    </main>

    <!-- Botón flotante de WhatsApp -->
    <a href="https://wa.me/5493814011766?text=Hola!%20Me%20contacto%20desde%20la%20web.%20Quisiera%20asesoramiento%20sobre%20la%20constitución%20de%20una%20SAS.%20¡Gracias!" target="_blank" class="whatsapp-float" aria-label="Contactar por WhatsApp">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.885m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
      </svg>
    </a>

    <script is:inline>
      (function() {
        var ticking = false;

        function initReveal() {
          var reveals = document.querySelectorAll('.reveal');

          var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('active');
              }
            });
          }, {
            threshold: 0.1,
            rootMargin: '0px 0px -40px 0px'
          });

          reveals.forEach(function(el) {
            observer.observe(el);
          });
        }

        // Spotlight effect - throttled
        function initSpotlight() {
          var cards = document.querySelectorAll('.glass-panel');
          cards.forEach(function(card) {
            card.addEventListener('mousemove', function(e) {
              if (!ticking) {
                requestAnimationFrame(function() {
                  var rect = card.getBoundingClientRect();
                  card.style.setProperty('--mouse-x', (e.clientX - rect.left) + 'px');
                  card.style.setProperty('--mouse-y', (e.clientY - rect.top) + 'px');
                  ticking = false;
                });
                ticking = true;
              }
            });
          });
        }

        // Scroll Progress - passive + RAF
        function initProgress() {
          var progressLine = document.getElementById('progress-line');
          if (!progressLine) return;
          var rafPending = false;
          window.addEventListener('scroll', function() {
            if (!rafPending) {
              requestAnimationFrame(function() {
                var scrollTop = window.scrollY;
                var totalH = document.documentElement.scrollHeight - window.innerHeight;
                progressLine.style.height = (scrollTop / totalH * 100) + '%';
                rafPending = false;
              });
              rafPending = true;
            }
          }, { passive: true });
        }

        initReveal();
        initSpotlight();
        initProgress();

        document.addEventListener('astro:page-load', function() {
          initReveal();
          initSpotlight();
          initProgress();
        });
      })();
    </script>
  </body>
</html>
