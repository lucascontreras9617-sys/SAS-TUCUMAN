---
---
<div class="location-selector reveal">
  <p class="selector-label">Seleccioná tu provincia para comenzar</p>
  <div class="selector-grid">
    <a href="/cordoba" class="location-card">
      <div class="card-content">
        <span class="location-name">Córdoba</span>
        <span class="location-detail">IPJ · CiDi Nivel 2</span>
      </div>
      <div class="card-arrow">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </div>
    </a>
    
    <a href="/mendoza" class="location-card">
      <div class="card-content">
        <span class="location-name">Mendoza</span>
        <span class="location-detail">MxM · Sin Boletín Oficial</span>
      </div>
      <div class="card-arrow">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </div>
    </a>
  </div>
</div>

<style>
  .location-selector {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--glass-border);
  }

  .selector-label {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.1rem;
    letter-spacing: 4px;
    color: var(--accent-gold);
    margin-bottom: 2.5rem;
    font-weight: 700;
  }

  .selector-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .location-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.8rem 2.22rem;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: relative;
    overflow: hidden;
  }

  .location-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, transparent, rgba(212, 175, 55, 0.05), transparent);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .location-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-gold);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .location-card:hover::before {
    transform: translateX(100%);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .location-name {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .location-detail {
    font-size: 0.75rem;
    color: var(--text-secondary);
    letter-spacing: 0.5px;
  }

  .card-arrow {
    color: var(--accent-gold);
    opacity: 0.5;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .location-card:hover .card-arrow {
    transform: translateX(5px);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .selector-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
