---
export interface Props {
  name: string;
  fill?: boolean;
  size?: number;
  class?: string;
}

const { name, fill = false, size = 24, class: className = '' } = Astro.props;
---

<span
  class={`material-symbols-outlined ${className}`}
  style={`font-size: ${size}px; font-variation-settings: 'FILL' ${fill ? 1 : 0};`}
  aria-hidden="true"
>
  {name}
</span>