---
---
<div class="cursor-dot" id="cursor-dot"></div>
<div class="cursor-ring" id="cursor-ring"></div>

<style>
  /* Solo mostrar custom cursor en dispositivos Desktop que soporten hover real */
  @media (pointer: fine) {
    body {
      cursor: none;
    }
  }

  .cursor-dot {
    position: fixed;
    top: 0;
    left: 0;
    width: 6px;
    height: 6px;
    background-color: var(--accent-gold);
    border-radius: 50%;
    z-index: 10000;
    pointer-events: none;
    opacity: 0;
    transition: width 0.2s, height 0.2s, background-color 0.2s, opacity 0.3s;
  }

  .cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--accent-gold);
    border-radius: 50%;
    z-index: 9999;
    pointer-events: none;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: width 0.2s, height 0.2s, background-color 0.2s, border-color 0.2s, opacity 0.3s;
    /* La interpolación espacial del anillo se hará mediante JS */
  }

  /* Estados Magnéticos/Hover */
  .cursor-dot.jelly {
    width: 4px;
    height: 4px;
  }

  .cursor-ring.jelly {
    width: 50px;
    height: 50px;
    background-color: rgba(212, 175, 55, 0.1);
    border-color: transparent;
  }
</style>

<script>
  function initCursor() {
    if (!matchMedia('(pointer: fine)').matches) return;

    const dot = document.getElementById('cursor-dot');
    const ring = document.getElementById('cursor-ring');
    
    if (!dot || !ring) return;

    let mouseX = -100;
    let mouseY = -100;
    let ringX = -100;
    let ringY = -100;
    let isVisible = false;

    const speed = 0.15;

    function updatePosition(e) {
      mouseX = e.clientX;
      mouseY = e.clientY;
      
      if (!isVisible) {
        isVisible = true;
        dot.style.opacity = '1';
        ring.style.opacity = '1';
      }
      
      dot.style.transform = `translate(${mouseX}px, ${mouseY}px) translate(-50%, -50%)`;
    }

    function handleMouseLeave() {
      isVisible = false;
      dot.style.opacity = '0';
      ring.style.opacity = '0';
    }

    const animate = () => {
      ringX += (mouseX - ringX) * speed;
      ringY += (mouseY - ringY) * speed;

      ring.style.transform = `translate(${ringX}px, ${ringY}px) translate(-50%, -50%)`;
      requestAnimationFrame(animate);
    };

    const addMagneticListeners = () => {
      const clickables = document.querySelectorAll('a, button, .faq-item, .glass-panel, .location-card');
      clickables.forEach(el => {
        el.addEventListener('mouseenter', () => {
          dot.classList.add('jelly');
          ring.classList.add('jelly');
        });
        el.addEventListener('mouseleave', () => {
          dot.classList.remove('jelly');
          ring.classList.remove('jelly');
        });
      });
    }

    window.addEventListener('mousemove', updatePosition);
    window.addEventListener('mouseout', (e) => {
      if (!e.relatedTarget) handleMouseLeave();
    });
    
    animate();
    addMagneticListeners();
  }

  // Initialize on page load and after every transition
  document.addEventListener('astro:page-load', initCursor);
  
  // Initial run
  initCursor();
</script>
