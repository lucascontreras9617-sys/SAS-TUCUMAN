---
export const prerender = true;
import BaseLayout from '../components/layout/BaseLayout.astro';
import LocalSEOHead from '../components/layout/LocalSEOHead.astro';
import Hero from '../components/sections/Hero.astro';
import Stats from '../components/sections/Stats.astro';
import TrustBadges from '../components/sections/TrustBadges.astro';
---

<BaseLayout title="Constituir SAS en Argentina" localSEO={true}>
  <LocalSEOHead locationContext="home" />
  <Hero />
  <TrustBadges />
  <Stats />
  
  <footer class="footer">
    <div class="footer-watermark" aria-hidden="true">Estudio&nbsp;SAS</div>
    <div class="footer-top-line"></div>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <span class="brand-text">Estudio <span class="text-gold">SAS</span></span>
          <p class="branding-text">Líderes en legal-tech para la constitución de sociedades en Córdoba y Mendoza.</p>
        </div>
        <div class="footer-links">
          <h4>Jurisdicciones</h4>
          <ul>
            <li><a href="/cordoba" class="magnetic-link">SAS Córdoba</a></li>
            <li><a href="/mendoza" class="magnetic-link">SAS Mendoza</a></li>
            <li><a href="/#proceso" class="magnetic-link">SAS Argentina (Federal)</a></li>
            <li><a href="/blog" class="magnetic-link">Blog Legal</a></li>
          </ul>
        </div>
        <div class="footer-contact">
          <h4>Operaciones</h4>
          <ul>
            <li>Córdoba · Mendoza</li>
            <li>Argentina</li>
            <li>Atención 100% Digital</li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Estudio SAS. Todos los derechos reservados.</p>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  /* Footer Rediseñado */
  .footer {
    background: var(--bg-secondary);
    padding: 80px 0 30px;
    position: relative;
    overflow: hidden;
  }

  /* Línea dorada superior del footer */
  .footer-top-line {
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
    margin-bottom: 60px;
    opacity: 0.5;
  }

  /* Marca de agua tipográfica */
  .footer-watermark {
    position: absolute;
    bottom: -20px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(80px, 15vw, 180px);
    font-weight: 700;
    color: var(--accent-gold);
    opacity: 0.025;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    line-height: 1;
  }
  
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 4rem;
    margin-bottom: 3rem;
    position: relative;
    z-index: 1;
  }
  
  .brand-text {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 1.2rem;
    display: block;
  }
  
  .branding-text {
    color: var(--text-secondary);
    font-size: 0.9rem;
    max-width: 300px;
    line-height: 1.6;
  }
  
  h4 {
    font-size: 0.8rem;
    margin-bottom: 1.5rem;
    color: var(--accent-gold);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-family: var(--font-display);
    font-weight: 600;
  }
  
  ul {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  
  ul li, ul li a {
    color: var(--text-secondary);
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }
  
  ul li a:hover {
    color: var(--accent-gold);
  }
  
  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid var(--glass-border);
    text-align: center;
    position: relative;
    z-index: 1;
  }
  
  .footer-bottom p {
    font-size: 0.8rem;
    color: var(--text-secondary);
    opacity: 0.5;
  }
  
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
