---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';

export async function getStaticPaths() {
  const articulos = await getCollection('articulos');
  return articulos.map((articulo) => ({
    params: { slug: articulo.slug },
    props: { articulo },
  }));
}

const { articulo } = Astro.props;
const { Content } = await articulo.render();

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-AR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<BaseLayout title={articulo.data.title}>
  <article class="blog-post">
    <header class="post-header container">
      <div class="meta reveal">
        <span class="category">{articulo.data.category}</span>
        <span class="dot">·</span>
        <span class="date">{formatDate(articulo.data.date)}</span>
      </div>
      <h1 class="reveal delay-100">{articulo.data.title}</h1>
      <div class="author reveal delay-200">
        Por <strong>{articulo.data.author}</strong>
      </div>
    </header>

    <div class="post-content container reveal delay-300">
      <Content />
    </div>

    <footer class="post-footer container reveal">
      <div class="divider"></div>
      <div class="cta-mini">
        <h3>¿Necesitás asesoramiento especializado?</h3>
        <p>Nuestro equipo de abogados y contadores está listo para ayudarte con tu SAS.</p>
        <a href="/" class="btn-primary">Volver al Inicio</a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  .blog-post {
    padding: 180px 0 120px;
  }

  .post-header {
    margin-bottom: 4rem;
    text-align: center;
  }

  .post-header .meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.5rem;
    color: var(--accent-gold);
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .post-header h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 2rem;
    line-height: 1.2;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .post-header .author {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .post-content {
    max-width: 800px;
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .post-content h2 {
    color: var(--text-primary);
    font-size: 2rem;
    margin: 3rem 0 1.5rem;
  }

  .post-content h3 {
    color: var(--text-primary);
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
  }

  .post-content p {
    margin-bottom: 1.5rem;
  }

  .post-content ul {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
    list-style: disc;
  }

  .post-content li {
    margin-bottom: 0.8rem;
  }

  .post-content strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .post-footer {
    margin-top: 6rem;
    max-width: 800px;
  }

  .divider {
    height: 1px;
    background: var(--glass-border);
    margin-bottom: 4rem;
  }

  .cta-mini {
    text-align: center;
    padding: 3rem;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
  }

  .cta-mini h3 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }

  .cta-mini p {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }
</style>
