---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articulos = (await getCollection('articulos'))
  .sort((a: any, b: any) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-AR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<BaseLayout title="Blog Legal | Actualidad SAS Córdoba y Mendoza">
  <section class="blog-header">
    <div class="container reveal">
      <div class="badge">Conocimiento Legal</div>
      <h1>Nuestro <span class="text-gold">Blog</span></h1>
      <p>Análisis técnicos, novedades normativas y guías prácticas para emprendedores en Argentina.</p>
    </div>
  </section>

  <section class="articles-list">
    <div class="container">
      <div class="articles-grid">
        {articulos.map((articulo: any, idx: number) => (
          <article class={`article-card glass-panel reveal delay-${(idx + 1) * 100}`}>
            <div class="article-category">
              <span class="category-tag">{articulo.data.category}</span>
            </div>
            <div class="article-body">
              <h3>{articulo.data.title}</h3>
              <p class="article-excerpt">{articulo.data.description}</p>
            </div>
            <div class="article-meta">
              <div class="meta-left">
                <span class="author">{articulo.data.author}</span>
                <span class="date">{formatDate(articulo.data.date)}</span>
              </div>
              <a href={`/blog/${articulo.slug}`} class="read-more">Leer más</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-header {
    padding: 160px 0 60px;
    text-align: center;
    background: radial-gradient(circle at center, rgba(212, 175, 55, 0.03) 0%, transparent 70%);
  }

  h1 {
    font-size: clamp(3rem, 6vw, 4.5rem);
    margin: 1rem 0;
  }

  .blog-header p {
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
    font-size: 1.2rem;
  }

  .badge {
    display: inline-block;
    padding: 6px 16px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--accent-gold);
  }

  .articles-list {
    padding: 60px 0 120px;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }

  .article-category {
    padding: 2rem 2.5rem 0;
  }

  .category-tag {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent-gold);
    font-weight: 700;
  }

  .article-body {
    padding: 1rem 2.5rem 2rem;
    flex-grow: 1;
  }

  .article-body h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .article-excerpt {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .article-meta {
    padding: 1.5rem 2.5rem;
    border-top: 1px solid var(--glass-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .meta-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .author {
    font-size: 0.8rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .date {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .read-more {
    color: var(--accent-gold);
    font-weight: 700;
    text-decoration: none;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  @media (max-width: 768px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
