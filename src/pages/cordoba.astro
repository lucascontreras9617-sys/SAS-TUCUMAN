---
export const prerender = true;
import BaseLayout from '../components/layout/BaseLayout.astro';
import LocalSEOHead from '../components/layout/LocalSEOHead.astro';
import TrustBadges from '../components/sections/TrustBadges.astro';
import stats from '../components/sections/Stats.astro';
import QueEsSAS from '../components/sections/QueEsSAS.astro';
import Proceso from '../components/sections/Proceso.astro';
import Precios from '../components/sections/Precios.astro';
import FAQ from '../components/sections/FAQ.astro';
import ArticulosSection from '../components/sections/ArticulosSection.astro';
import CTASection from '../components/sections/CTASection.astro';

// Custom Hero for Córdoba
---

<BaseLayout title="SAS en Córdoba | Trámite Online Express IPJ">
  <LocalSEOHead 
    locationContext="cordoba" 
    title="SAS en Córdoba | Trámite Online Express IPJ | Estudio SAS"
    description="Creá tu SAS en Córdoba en 24-48hs. Integración total con IPJ y CiDi Nivel 2. Modelos Tailor-Made para startups y bonificación en Bancor."
  />

  <section class="hero-section regional-hero">
    <div class="container hero-content">
      <div class="hero-text-wrapper reveal">
        <div class="badge font-sans">Jurisdicción: Córdoba</div>
        <h1>
          Constitución de SAS <br />
          <span class="text-gradient">en Córdoba</span>
        </h1>
        <p class="hero-description font-sans">
          Trámite 100% online vía <strong>Inspección de Personas Jurídicas (IPJ)</strong>. 
          Validación biométrica mediante <strong>CiDi Nivel 2</strong> y apertura de cuenta automática en <strong>Bancor</strong>.
        </p>
        
        <div class="hero-actions">
          <a href="#contacto" class="btn-primary">Iniciar SAS en Córdoba con CiDi</a>
          <a href="#beneficios" class="btn-secondary">Requisitos 2026</a>
        </div>

        <ul class="local-highlights">
          <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17L4 12"/></svg> Integración total con CiDi Nivel 2</li>
          <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17L4 12"/></svg> Modelo Tailor-Made (Vesting & Tag Along)</li>
          <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17L4 12"/></svg> CUIT automático interoperabilidad AFIP</li>
        </ul>
      </div>

      <div class="hero-visual reveal">
        <div class="image-wrapper glass-panel">
          <img src="/images/regions/cordoba.png" alt="La Cañada en Córdoba Capital" class="region-image" />
          <div class="feature-overlay">
            <div class="card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
              </svg>
            </div>
            <div class="overlay-text">
              <h3>Velocidad IPJ</h3>
              <p>Aprobación en 24-48hs hábiles.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TrustBadges province="cordoba" />
  <QueEsSAS />
  <Proceso />
  <Precios />
  <FAQ />
  <ArticulosSection />
  <CTASection />

  <footer class="footer">
    <div class="footer-watermark" aria-hidden="true">CÓRDOBA</div>
    <div class="footer-top-line"></div>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <span class="brand-text">Estudio <span class="text-gold">SAS</span></span>
          <p class="branding-text">Líderes en legal-tech para la constitución de sociedades en Córdoba y Mendoza.</p>
        </div>
        <div class="footer-links">
          <h4>Vínculos</h4>
          <ul>
            <li><a href="/" class="magnetic-link">Home Argentina</a></li>
            <li><a href="/mendoza" class="magnetic-link">Mendoza</a></li>
            <li><a href="/blog" class="magnetic-link">Artículos</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Estudio SAS. Jurisdicción Córdoba.</p>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  .regional-hero {
    padding: 160px 0 100px;
    background: radial-gradient(circle at top right, rgba(212, 175, 55, 0.05) 0%, transparent 60%);
  }
  
  .local-highlights {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .local-highlights li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .local-highlights li svg {
    color: var(--accent-gold);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    position: relative;
  }

  .image-wrapper {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 450px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .region-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .image-wrapper:hover .region-image {
    transform: scale(1.05);
  }

  .feature-overlay {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: 15px;
    padding: 1.2rem;
    display: flex;
    align-items: center;
    gap: 15px;
    z-index: 2;
  }

  .overlay-text h3 {
    font-size: 1rem;
    margin-bottom: 2px;
    color: var(--text-primary);
  }

  .overlay-text p {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .card-icon {
    flex-shrink: 0;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .badge {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--accent-gold);
    color: var(--accent-gold);
    border-radius: 20px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
  }

  .footer {
    background: var(--bg-secondary);
    padding: 80px 0 30px;
    position: relative;
    overflow: hidden;
  }

  .footer-top-line {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--glass-border), transparent);
    margin-bottom: 40px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    display: block;
  }

  .footer-watermark {
    position: absolute;
    bottom: -10px;
    right: 0;
    font-size: 12rem;
    font-weight: 900;
    opacity: 0.03;
    color: var(--accent-gold);
    pointer-events: none;
  }
</style>
