---
export const prerender = true;
import BaseLayout from '../components/layout/BaseLayout.astro';
import LocalSEOHead from '../components/layout/LocalSEOHead.astro';
import TrustBadges from '../components/sections/TrustBadges.astro';
import stats from '../components/sections/Stats.astro';
import QueEsSAS from '../components/sections/QueEsSAS.astro';
import Proceso from '../components/sections/Proceso.astro';
import Precios from '../components/sections/Precios.astro';
import FAQ from '../components/sections/FAQ.astro';
import ArticulosSection from '../components/sections/ArticulosSection.astro';
import CTASection from '../components/sections/CTASection.astro';

// Custom Hero for Córdoba
---

<BaseLayout title="SAS en Córdoba | Trámite Online Express IPJ" localSEO={true}>
  <LocalSEOHead 
    locationContext="cordoba" 
    title="SAS en Córdoba | Trámite Online Express IPJ | Estudio SAS"
    description="Creá tu SAS en Córdoba en 24-48hs. Integración total con IPJ y CiDi Nivel 2. Modelos Tailor-Made para startups y bonificación en Bancor."
  />

  <!-- Full-width city banner -->
  <div class="city-banner reveal">
    <img
      src="/images/regions/cordoba2.jpg"
      alt="Ciudad de Córdoba, Argentina"
      class="city-banner-img"
    />
    <div class="city-banner-overlay">
      <span class="city-banner-label">Córdoba, Argentina</span>
    </div>
  </div>

  <section class="hero-section regional-hero">
    <div class="container hero-content">
      <div class="hero-text-wrapper reveal">
        <div class="badge font-sans">Jurisdicción: Córdoba</div>
        <h1>
          Constitución de SAS <br />
          <span class="text-gradient">en Córdoba</span>
        </h1>
        <p class="hero-description font-sans">
          Trámite 100% online vía <strong>Inspección de Personas Jurídicas (IPJ)</strong>. 
          Validación biométrica mediante <strong>CiDi Nivel 2</strong> y apertura de cuenta automática en <strong>Bancor</strong>.
        </p>
        
        <div class="hero-actions">
          <a href="#contacto" class="btn-primary">Iniciar SAS en Córdoba con CiDi</a>
          <a href="#beneficios" class="btn-secondary">Requisitos 2026</a>
        </div>

        <ul class="local-highlights">
          <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17L4 12"/></svg> Integración total con CiDi Nivel 2</li>
          <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17L4 12"/></svg> Modelo Tailor-Made (Vesting &amp; Tag Along)</li>
          <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17L4 12"/></svg> CUIT automático interoperabilidad AFIP</li>
        </ul>
      </div>
    </div>
  </section>

  <TrustBadges province="cordoba" />
  <QueEsSAS />
  <Proceso />
  <Precios provincia="cordoba" />
  <FAQ />
  <ArticulosSection />
  <CTASection />

  <footer class="footer">
    <div class="footer-watermark" aria-hidden="true">CÓRDOBA</div>
    <div class="footer-top-line"></div>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <span class="brand-text">Estudio <span class="text-gold">SAS</span></span>
          <p class="branding-text">Líderes en legal-tech para la constitución de sociedades en Córdoba y Mendoza.</p>
        </div>
        <div class="footer-links">
          <h4>Vínculos</h4>
          <ul>
            <li><a href="/" class="magnetic-link">Home Argentina</a></li>
            <li><a href="/mendoza" class="magnetic-link">Mendoza</a></li>
            <li><a href="/blog" class="magnetic-link">Artículos</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Estudio SAS. Jurisdicción Córdoba.</p>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ===== CITY BANNER ===== */
  .city-banner {
    position: relative;
    width: 100%;
    height: 420px;
    overflow: hidden;
    margin-top: 72px; /* nav height offset */
  }

  .city-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    display: block;
    transition: transform 8s ease;
  }

  .city-banner:hover .city-banner-img {
    transform: scale(1.03);
  }

  .city-banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.15) 0%,
      rgba(0,0,0,0.45) 60%,
      rgba(0,0,0,0.72) 100%
    );
    display: flex;
    align-items: flex-end;
    padding: 2rem 2.5rem;
  }

  .city-banner-label {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    border-left: 2px solid var(--accent-gold);
    padding-left: 0.75rem;
  }

  /* ===== REGIONAL HERO ===== */
  .regional-hero {
    padding: 80px 0 100px;
    background: radial-gradient(circle at top right, rgba(212, 175, 55, 0.05) 0%, transparent 60%);
  }
  
  .local-highlights {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .local-highlights li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.95rem;
    color: var(--text-secondary);
    transition: color 0.3s ease;
  }

  .local-highlights li:hover {
    color: var(--text-primary);
  }

  .local-highlights li svg {
    color: var(--accent-gold);
    flex-shrink: 0;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .badge {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--accent-gold);
    color: var(--accent-gold);
    border-radius: 20px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .footer {
    background: var(--bg-secondary);
    padding: 80px 0 30px;
    position: relative;
    overflow: hidden;
  }

  .footer-top-line {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--glass-border), transparent);
    margin-bottom: 40px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    display: block;
  }

  .footer-watermark {
    position: absolute;
    bottom: -10px;
    right: 0;
    font-size: 12rem;
    font-weight: 900;
    opacity: 0.03;
    color: var(--accent-gold);
    pointer-events: none;
  }
</style>
